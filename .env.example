# ============================================================
# AutoTest - cau hinh moi truong (file MAU, chi chua gia tri gia)
# Sao chep thanh .env va dien gia tri that tren may chay:
#   cp .env.example .env
# KHONG bao gio commit file .env that len Git.
# ============================================================

# --- Cong dich vu (khop docker-compose.yml) ---
CONTROL_PORT=3100
ORCHESTRATOR_PORT=3101
ORCHESTRATOR_URL=http://localhost:3101

# --- DB noi bo cua AutoTest (chi dung trong mang compose) ---
POSTGRES_USER=autotest
POSTGRES_PASSWORD=doi-mat-khau-nay-tren-may-that
POSTGRES_DB=autotest
DATABASE_URL=postgres://autotest:doi-mat-khau-nay-tren-may-that@localhost:5432/autotest

# --- Dich kiem thu (UAT) - dien day du o Story S1.2 ---
# URL he thong duoc kiem thu (chi duoc phep la UAT)
TARGET_BASE_URL=https://uat.example.invalid
# Danh sach URL duoc phep chay, cach nhau bang dau phay (chi khai bao origin hoac tien to URL)
TARGET_ALLOWLIST=https://uat.example.invalid
# Tenant / chi nhanh chi danh cho auto test tren UAT
TEST_TENANT=autotest-tenant-mau

# --- Tai khoan tren UAT theo vai (mat khau chi o .env that) ---
ROLE_BENH_NHAN_USERNAME=benh-nhan-mau@example.invalid
ROLE_BENH_NHAN_PASSWORD=mat-khau-gia
ROLE_LE_TAN_USERNAME=le-tan-mau@example.invalid
ROLE_LE_TAN_PASSWORD=mat-khau-gia
ROLE_BAC_SI_USERNAME=bac-si-mau@example.invalid
ROLE_BAC_SI_PASSWORD=mat-khau-gia
ROLE_THU_NGAN_USERNAME=thu-ngan-mau@example.invalid
ROLE_THU_NGAN_PASSWORD=mat-khau-gia
ROLE_QUAN_LY_USERNAME=quan-ly-mau@example.invalid
ROLE_QUAN_LY_PASSWORD=mat-khau-gia

# --- Kenh ngoai Zalo/Facebook/SMS tren UAT: bat buoc true (sandbox) moi duoc chay ---
CHANNELS_SANDBOX=true

# --- Playwright: S1.1 chua cai browser, bo qua tai browser khi cai dat ---
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# --- Danh sach du lieu that bi cam trong du lieu sinh (S2.3, khong bat buoc) ---
# Duong dan toi file JSON {"names": [...], "phones": [...]} do chu du an cung cap;
# de trong = danh sach rong. Bo sinh du lieu se tu choi neu sinh trung danh sach nay.
BANNED_DATA_FILE=
