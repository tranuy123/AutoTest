# ============================================================
# AutoTest - cau hinh moi truong (file MAU, chi chua gia tri gia)
# Sao chep thanh .env va dien gia tri that tren may chay:
#   cp .env.example .env
# KHONG bao gio commit file .env that len Git.
# ============================================================

# --- Cong dich vu (khop docker-compose.yml) ---
CONTROL_PORT=3100
ORCHESTRATOR_PORT=3101
ORCHESTRATOR_URL=http://localhost:3101

# --- Worker chay kich ban + Stream Gateway (Epic 3) ---
RUNNER_PORT=3102
RUNNER_URL=http://localhost:3102
# URL WebSocket ma trinh duyet dung de xem stream (qua cong publish cua runner)
STREAM_GATEWAY_WS_URL=ws://localhost:3102
# Thu muc luu artifact lan chay (video, anh, ket-qua.json); trong compose la /data
AUTOTEST_DATA_DIR=runs-data
# Gioi han phien trinh duyet chay dong thoi (NFR-3), mac dinh 5
MAX_PARALLEL_SESSIONS=5
# Gioi han lan chay thuc thi dong thoi (S5.2 AC-1), mac dinh 2 - lan chay vuot gioi han xep hang "Dang cho phien trong"
MAX_CONCURRENT_RUNS=2
# Thoi gian an han khi bam Dung lan chay (S5.2): phien dang chay duoc cho bao ket qua tu nhien toi da bay lau (ms), mac dinh 30000
STOP_GRACE_MS=30000
# Nhịp xem truc tiep: so mili-giay nghi giua cac buoc o che do xem, mac dinh 400
VIEW_PACE_MS=400
# true = giu video ca lan chay QUA; mac dinh false (chi giu video lan chay hong)
VIDEO_KEEP_ON_PASS=false
# Mau duong API don du lieu test cua CRM (S2.4) - de trong dung mac dinh /api/test-data/{type}/{id}
CRM_CLEANUP_PATH_TEMPLATE=
# Token cho endpoint don du lieu test cua CRM neu CRM yeu cau (khong bat buoc)
CRM_CLEANUP_TOKEN=

# --- DB noi bo cua AutoTest (chi dung trong mang compose) ---
POSTGRES_USER=autotest
POSTGRES_PASSWORD=doi-mat-khau-nay-tren-may-that
POSTGRES_DB=autotest
DATABASE_URL=postgres://autotest:doi-mat-khau-nay-tren-may-that@localhost:5432/autotest

# --- Dich kiem thu (UAT) - dien day du o Story S1.2 ---
# URL he thong duoc kiem thu (chi duoc phep la UAT)
TARGET_BASE_URL=https://uat.example.invalid
# Danh sach URL duoc phep chay, cach nhau bang dau phay (chi khai bao origin hoac tien to URL)
TARGET_ALLOWLIST=https://uat.example.invalid
# Tenant / chi nhanh chi danh cho auto test tren UAT
TEST_TENANT=autotest-tenant-mau

# --- Tai khoan tren UAT theo vai (mat khau chi o .env that) ---
ROLE_BENH_NHAN_USERNAME=benh-nhan-mau@example.invalid
ROLE_BENH_NHAN_PASSWORD=mat-khau-gia
ROLE_LE_TAN_USERNAME=le-tan-mau@example.invalid
ROLE_LE_TAN_PASSWORD=mat-khau-gia
ROLE_BAC_SI_USERNAME=bac-si-mau@example.invalid
ROLE_BAC_SI_PASSWORD=mat-khau-gia
ROLE_THU_NGAN_USERNAME=thu-ngan-mau@example.invalid
ROLE_THU_NGAN_PASSWORD=mat-khau-gia
ROLE_QUAN_LY_USERNAME=quan-ly-mau@example.invalid
ROLE_QUAN_LY_PASSWORD=mat-khau-gia

# --- Kenh ngoai Zalo/Facebook/SMS tren UAT: bat buoc true (sandbox) moi duoc chay ---
CHANNELS_SANDBOX=true
# Duong dan health cua CRM de he thong tu doc co sandbox kenh ngoai tu dich
# (S5.3); de trong dung mac dinh /api/health. Health tra JSON co khoa
# sandbox / kenhNgoaiSandbox / channelsSandbox (boolean) thi he thong dung
# tin hieu do; khong co thi dung CHANNELS_SANDBOX. Khong tin hieu nao xac
# nhan duoc sandbox -> kich ban co kenh ngoai bi chan (fail-closed).
CRM_HEALTH_PATH=

# --- Playwright: S1.1 chua cai browser, bo qua tai browser khi cai dat ---
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# --- Nguon so lieu kiem dem doanh thu (S4.2) ---
# API bao cao cua CRM tren dich (duong dan tuong doi so voi TARGET_BASE_URL);
# de trong dung mac dinh /api/bao-cao/doanh-thu. API can tra JSON gom:
# tongDoanhThu, soLuotCheckIn, soLichHen, theoKhachHang[{id|hoTen, doanhThu}]
# loc theo query tuNgay/denNgay/tenant/runId.
CRM_API_BAO_CAO_PATH=
# Connection string CHI DOC toi DB cua DICH KIEM THU (khong phai DB noi bo
# cua AutoTest). De trong = nguon DB "khong kiem chung duoc" moi lan chay.
CRM_DB_READONLY_URL=
# Cau SQL chi doc cho tung loai chi tieu; ket qua doc o cot gia_tri.
# Tham so: $1 ngay (YYYY-MM-DD), $2 nhan dien test AUTOTEST_<runId>,
# $3 tenant, $4 id khach chinh, $5 ho ten khach chinh, $6 so dien thoai.
# Rieng doanh thu theo khach co the tra nhieu dong kem cot khoa.
CRM_DB_SQL_TONG_DOANH_THU=
CRM_DB_SQL_DOANH_THU_KHACH=
CRM_DB_SQL_SO_CHECK_IN=
CRM_DB_SQL_SO_LICH_HEN=

# --- Danh sach du lieu that bi cam trong du lieu sinh (S2.3, khong bat buoc) ---
# Duong dan toi file JSON {"names": [...], "phones": [...]} do chu du an cung cap;
# de trong = danh sach rong. Bo sinh du lieu se tu choi neu sinh trung danh sach nay.
BANNED_DATA_FILE=
